{
  "name": "@tis-lab/bdc-dp-ui",
  "version": "0.0.1",
  "description": "This repository contains the Cohort Builder component for the BDC Data Portal. It enables users to build cohorts from data available in the BDC Ecosystem.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:lib && npm run build:app",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 8080",
    "prepublishOnly": "npm run build:lib",
    "test:unit": "jest --coverage --config=jest.config.js",
    "test:coverageReport": "nyc report --report-dir=testResults/coverage --reporter=lcov --reporter=cobertura --reporter=html -t testResults/coverage",
    "test": "npm run test:unit && npm run test:coverageReport"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "nyc": "^18.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^5.1.0",
    "whatwg-fetch": "^3.6.20"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.2.0",
    "echarts": "^5.0.0 || ^6.0.0",
    "echarts-for-react": "^3.0.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "jestSonar": {
    "reportPath": "testResults",
    "reportFile": "test-report.xml",
    "indent": 4
  }
}
